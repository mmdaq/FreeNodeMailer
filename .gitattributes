# Normalize line endings so Windows/Linux cross-commits stay clean.
# NOTE: .gitattributes does NOT support non-ASCII comments -- keep this file ASCII-only,
# otherwise git reports "<comment> is not a valid attribute name".
* text=auto eol=lf

# Windows scripts: keep CRLF for best compatibility with cmd.exe / PowerShell 5.1
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary payloads: never touch line endings
*.exe binary
*.dat binary
*.mmdb binary
*.metadb binary
