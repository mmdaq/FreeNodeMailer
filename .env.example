# ============================================================
# FreeNodeMailer 邮箱配置模板
# 用法：复制本文件为 .env，填入真实值。.env 不会提交到 git。
# ============================================================

# 发件邮箱（QQ 邮箱）
QQ_EMAIL=385096659@qq.com

# QQ 邮箱 SMTP 授权码（16 位，不是 QQ 登录密码！）
# 获取方式：QQ邮箱网页版 → 设置 → 账号 → POP3/IMAP/SMTP服务 → 开启
#           → 生成授权码
QQ_AUTH=

# 收件人（多个用英文逗号分隔，留空则默认发给 QQ_EMAIL 自己）
MAIL_TO=385096659@qq.com

# ---- 可选：GitHub 推送（本地跑完把结果提交回仓库时需要）----
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_BRANCH=main

# ---- 可选：覆盖设置（留空则用 config/settings.yaml）----
# FNM_MAX_DELAY=500
# FNM_MAX_NODES=200
# FNM_CORE_PATH=
